          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{BASE_URL}}/api/Account/AccountDetailsGet", "host": ["{{BASE_URL}}"], "path": ["api","Account","AccountDetailsGet"] },
            "body": { "mode": "raw", "raw": "{\n  \"SessionToken\": \"{{randgo_session_token}}\"\n}" }
