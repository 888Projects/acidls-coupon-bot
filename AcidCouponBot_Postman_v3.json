          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Webhook accepted', () => pm.expect(pm.response.code).to.be.oneOf([200,204]));",
            "console.log('Response:', pm.response.text().substring(0,500));"
          ]}}],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{BOT_BASE_URL}}/webhook", "host": ["{{BOT_BASE_URL}}"], "path": ["webhook"] },
            "body": { "mode": "raw", "raw": "{\n  \"entry\": [{\n    \"changes\": [{\n      \"value\": {\n        \"messages\": [{\n          \"type\": \"text\",\n          \"from\": \"{{test_phone}}\",\n          \"text\": { \"body\": \"Coupon\" }\n        }]\n      }\n    }]\n  }]\n}" }
          },
          "description": "Simulates a customer sending 'Coupon' via WhatsApp.\nWebhook is public — no auth needed.\nChange test_phone to try 5 different numbers."
        }
      ]
    },

    {
      "name": "🏁 06 — Full QA Sign-off Flow",
      "description": "Run these 6 requests in sequence for the Randgo sign-off session.\nChange test_phone between runs to show 5 different accounts.",
      "item": [
