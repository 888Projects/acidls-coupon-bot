        {
          "name": "11 Member Import",
          "event": [{ "listen": "test", "script": { "exec": [
            "const res = pm.response.json();",
            "pm.test('Import queued', () => pm.expect(res.Success).to.be.true);",
            "if (res.Batch) {",
            "  pm.collectionVariables.set('batch_guid', res.Batch.Guid);",
            "  console.log('✅ BatchGuid saved:', res.Batch.Guid);",
            "  console.log('Status:', res.Batch.Status);",
            "  console.log('RowCount:', res.Batch.RowCount);",
            "}"
          ]}}],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{BASE_URL}}/api/Member/Import", "host": ["{{BASE_URL}}"], "path": ["api","Member","Import"] },
            "body": { "mode": "raw", "raw": "{\n  \"SessionToken\": \"{{randgo_session_token}}\",\n  \"ClientSchemeGuid\": \"{{client_scheme_guid}}\",\n  \"PrimaryKeyName\": \"Cellphone\",\n  \"ClientSchemMemberIdentifierGuid\": \"{{member_identifier_guid}}\",\n  \"Members\": [\n    {\n      \"UniqueUserKey\": \"{{test_phone}}\",\n      \"Cellphone\": \"{{test_phone}}\",\n      \"Active\": true,\n      \"Registered\": true\n    }\n  ]\n}" }
          },
          "description": "Path: api/Member/Import\nRegisters a customer under ACID's ClientScheme.\nNote: ClientSchemMemberIdentifierGuid has one M (doc typo — use as-is).\nBatchGuid auto-saved for polling."
        },
        {
          "name": "12 Batch Status (poll)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const res = pm.response.json();",
            "pm.test('Batch retrieved', () => pm.expect(res.Success).to.be.true);",
            "if (res.Batch) {",
            "  console.log('Status:', res.Batch.Status);",
            "  console.log('Progress:', res.Batch.Progress);",
            "  console.log('Imported:', res.Batch.ImportedRowCount, '/', res.Batch.RowCount);",
            "  if (res.Batch.FailedRowCount > 0) console.error('Failed:', res.Batch.FailedRowCount);",
            "  res.Batch.Status === 'Completed'",
            "    ? console.log('✅ Import COMPLETE — stop polling')",
            "    : console.log('⏳ Still importing — wait 20s then re-run');",
            "}"
          ]}}],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{BASE_URL}}/api/Member/Import/Batch/GetByBatchGuid", "host": ["{{BASE_URL}}"], "path": ["api","Member","Import","Batch","GetByBatchGuid"] },
            "body": { "mode": "raw", "raw": "{\n  \"SessionToken\": \"{{randgo_session_token}}\",\n  \"BatchGuid\": \"{{batch_guid}}\"\n}" }
          },
          "description": "Path: api/Member/Import/Batch/GetByBatchGuid\nBLOCKING: Max 1 call per 20s per batch.\nMust STOP polling when Status = Completed."
        },
        {
          "name": "13 Member Validate",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{BASE_URL}}/api/Member/Validate", "host": ["{{BASE_URL}}"], "path": ["api","Member","Validate"] },
            "body": { "mode": "raw", "raw": "{\n  \"SessionToken\": \"{{randgo_session_token}}\",\n  \"PrimaryKeyName\": \"Cellphone\",\n  \"PrimaryKeyValue\": \"{{test_phone}}\"\n}" }
          },
          "description": "Path: api/Member/Validate\nBLOCKING: Max 1/min per member."
        }
      ]
    },

