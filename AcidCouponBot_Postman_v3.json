            "body": { "mode": "raw", "raw": "{\n  \"SessionToken\": \"{{randgo_session_token}}\"\n}" }
          }
        },
        {
          "name": "QA Step 4 — Member Import",
          "event": [{ "listen": "test", "script": { "exec": [
