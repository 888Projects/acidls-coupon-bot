          "name": "QA Step 1 — Login",
          "event": [{ "listen": "test", "script": { "exec": [
            "const res = pm.response.json();",
            "pm.collectionVariables.set('randgo_session_token', res.Info?.SessionToken || '');",
            "pm.test('QA: Login OK', () => pm.expect(res.Success).to.be.true);",
            "pm.test('QA: Token present', () => pm.expect(res.Info?.SessionToken).to.be.a('string'));"
          ]}}],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{BASE_URL}}/api/Account/Login", "host": ["{{BASE_URL}}"], "path": ["api","Account","Login"] },
            "body": { "mode": "raw", "raw": "{\n  \"Username\": \"{{RANDGO_USERNAME}}\",\n  \"Password\": \"{{RANDGO_PASSWORD}}\"\n}" }
          }
        },
        {
