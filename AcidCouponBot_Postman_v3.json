            "console.log('BatchGuid:', res.Batch?.Guid, '| Status:', res.Batch?.Status);"
          ]}}],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{BASE_URL}}/api/Member/Import", "host": ["{{BASE_URL}}"], "path": ["api","Member","Import"] },
            "body": { "mode": "raw", "raw": "{\n  \"SessionToken\": \"{{randgo_session_token}}\",\n  \"ClientSchemeGuid\": \"{{client_scheme_guid}}\",\n  \"PrimaryKeyName\": \"Cellphone\",\n  \"ClientSchemMemberIdentifierGuid\": \"{{member_identifier_guid}}\",\n  \"Members\": [{\n    \"UniqueUserKey\": \"{{test_phone}}\",\n    \"Cellphone\": \"{{test_phone}}\",\n    \"Active\": true,\n    \"Registered\": true\n  }]\n}" }
          }
        },
        {
          "name": "QA Step 5 — Poll Batch (wait 20s first)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const res = pm.response.json();",
            "pm.test('QA: Batch retrieved', () => pm.expect(res.Success).to.be.true);",
            "console.log('Status:', res.Batch?.Status, '| Imported:', res.Batch?.ImportedRowCount, '/', res.Batch?.RowCount);",
            "if (res.Batch?.Status === 'Completed') console.log('✅ COMPLETE — do not poll again');",
            "else console.log('⏳ Pending — wait 20s then re-run');"
