    {
      "name": "🔐 01 — Randgo Account",
      "item": [
        {
          "name": "01 Login",
          "event": [{ "listen": "test", "script": { "exec": [
            "const res = pm.response.json();",
            "if (res.Info && res.Info.SessionToken) {",
            "  pm.collectionVariables.set('randgo_session_token', res.Info.SessionToken);",
            "  pm.collectionVariables.set('randgo_account_guid', res.Info.AccountGuid || '');",
            "  console.log('✅ SessionToken saved:', res.Info.SessionToken);",
            "} else { console.error('❌ Login failed:', JSON.stringify(res)); }",
            "pm.test('Success is true', () => pm.expect(res.Success).to.be.true);",
            "pm.test('SessionToken present', () => pm.expect(res.Info.SessionToken).to.be.a('string'));"
          ]}}],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{BASE_URL}}/api/Account/Login", "host": ["{{BASE_URL}}"], "path": ["api","Account","Login"] },
            "body": { "mode": "raw", "raw": "{\n  \"Username\": \"{{RANDGO_USERNAME}}\",\n  \"Password\": \"{{RANDGO_PASSWORD}}\"\n}" }
          },
          "description": "Path: api/Account/Login\nSchedule: Once per 24 hours or on token expiry.\nBLOCKING: >1 call/day = 2hr suspension on Live, 5min on QA.\nAuto-saves SessionToken."
        },
        {
          "name": "02 AccountDetailsGet",
          "event": [{ "listen": "test", "script": { "exec": [
            "const res = pm.response.json();",
            "pm.test('Success is true', () => pm.expect(res.Success).to.be.true);",
            "if (res.Info && res.Info.ClientSchemes && res.Info.ClientSchemes.length > 0) {",
            "  const scheme = res.Info.ClientSchemes[0];",
            "  pm.collectionVariables.set('client_scheme_guid', scheme.ClientSchemeGuid);",
            "  console.log('✅ ClientSchemeGuid:', scheme.ClientSchemeGuid);",
            "  if (scheme.MemberIdentifiers && scheme.MemberIdentifiers.length > 0) {",
            "    pm.collectionVariables.set('member_identifier_guid', scheme.MemberIdentifiers[0].ClientSchemeMemberIdentifierGuid);",
            "    console.log('✅ MemberIdentifierGuid:', scheme.MemberIdentifiers[0].ClientSchemeMemberIdentifierGuid);",
            "  }",
            "}"
          ]}}],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{BASE_URL}}/api/Account/AccountDetailsGet", "host": ["{{BASE_URL}}"], "path": ["api","Account","AccountDetailsGet"] },
            "body": { "mode": "raw", "raw": "{\n  \"SessionToken\": \"{{randgo_session_token}}\"\n}" }
          },
          "description": "Path: api/Account/AccountDetailsGet\nSchedule: Once per 24 hours, cache result.\nAuto-saves ClientSchemeGuid and MemberIdentifierGuid."
        }
      ]
    },

    {
      "name": "🎟️ 02 — Randgo Vouchers",
      "item": [
        {
          "name": "03 VouchersGet",
          "event": [{ "listen": "test", "script": { "exec": [
            "const res = pm.response.json();",
            "pm.test('Success is true', () => pm.expect(res.Success).to.be.true);",
            "if (res.Vendors) {",
            "  let count = 0;",
            "  res.Vendors.forEach(vendor => {",
            "    console.log('Vendor:', vendor.Name, vendor.Guid);",
            "    (vendor.Vouchers || []).forEach((v, i) => {",
            "      console.log('  Voucher['+i+']:', v.Name, '| Guid:', v.Guid, '| Type:', v.VoucherType);",
            "      if (count < 5) { pm.collectionVariables.set('voucher_guid_'+(count+1), v.Guid); count++; }",
            "    });",
            "  });",
            "  console.log('✅', count, 'VoucherGuids saved');",
            "}"
          ]}}],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{BASE_URL}}/api/Voucher/VouchersGet", "host": ["{{BASE_URL}}"], "path": ["api","Voucher","VouchersGet"] },
            "body": { "mode": "raw", "raw": "{\n  \"SessionToken\": \"{{randgo_session_token}}\"\n}" }
          },
          "description": "Path: api/Voucher/VouchersGet\nSchedule: 1st of month.\nBLOCKING: >10/week = suspension.\nAuto-saves first 5 VoucherGuids."
        },
        {
          "name": "04 VoucherRedemptionTypesGet",
          "event": [{ "listen": "test", "script": { "exec": [
            "const res = pm.response.json();",
            "pm.test('Success is true', () => pm.expect(res.Success).to.be.true);",
            "if (res.Types) { console.log('Redemption types:', JSON.stringify(res.Types)); }"
          ]}}],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{BASE_URL}}/api/Voucher/VoucherRedemptionTypesGet", "host": ["{{BASE_URL}}"], "path": ["api","Voucher","VoucherRedemptionTypesGet"] },
            "body": { "mode": "raw", "raw": "{\n  \"SessionToken\": \"{{randgo_session_token}}\"\n}" }
          },
          "description": "Path: api/Voucher/VoucherRedemptionTypesGet\nNote: doc has typo 'api/Vocuher/...' — correct path is 'api/Voucher/...'\nUse this to confirm valid RedemptionType values for CouponBasketCheckout."
        },
        {
          "name": "05 CodesAvailability",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{BASE_URL}}/api/Voucher/CodesAvailiblity", "host": ["{{BASE_URL}}"], "path": ["api","Voucher","CodesAvailiblity"] },
            "body": { "mode": "raw", "raw": "{\n  \"SessionToken\": \"{{randgo_session_token}}\",\n  \"ShowStockOnlyVouchers\": false\n}" }
          },
          "description": "Path: /api/Voucher/CodesAvailiblity (note: spelling from doc)\nBLOCKING: >1/30min = suspension."
        },
        {
          "name": "06 CodesGet (nightly fallback cache)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{BASE_URL}}/api/Voucher/CodesGet", "host": ["{{BASE_URL}}"], "path": ["api","Voucher","CodesGet"] },
            "body": { "mode": "raw", "raw": "{\n  \"SessionToken\": \"{{randgo_session_token}}\",\n  \"OfferingGuidList\": [\n    \"{{voucher_guid_1}}\",\n    \"{{voucher_guid_2}}\",\n    \"{{voucher_guid_3}}\",\n    \"{{voucher_guid_4}}\",\n    \"{{voucher_guid_5}}\"\n  ],\n  \"BatchNo\": \"\",\n  \"NewOnly\": true\n}" }
          },
          "description": "Path: api/Voucher/CodesGet\nBLOCKING: >1/10min = suspension.\nCodes are sensitive — never expose publicly."
        }
      ]
    },

    {
      "name": "🛒 03 — Randgo Coupon Basket",
      "item": [
        {
          "name": "07 CouponBasketCheckout ⚡ LIVE ISSUANCE",
          "event": [{ "listen": "test", "script": { "exec": [
            "const res = pm.response.json();",
            "pm.test('Checkout successful', () => pm.expect(res.Success).to.be.true);",
            "if (res.Basket) {",
            "  console.log('Basket GUID:', res.Basket.Guid);",
            "  if (res.Basket.Codes) {",
            "    console.log('\\n✅ CODES ISSUED:');",
            "    res.Basket.Codes.forEach((c, i) => console.log('  '+(i+1)+'.', c.IsssuedCode, '| Expires:', c.CancelDate));",
            "  }",
            "  if (res.Basket.Coupons) {",
            "    res.Basket.Coupons.forEach(c => {",
            "      if (c.IssueFailed) console.error('❌ Coupon failed:', c.VoucherGuid, c.RedemptionTemplate);",
            "    });",
            "  }",
            "}"
          ]}}],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{BASE_URL}}/api/Voucher/Coupon/Basket/Checkout", "host": ["{{BASE_URL}}"], "path": ["api","Voucher","Coupon","Basket","Checkout"] },
            "body": { "mode": "raw", "raw": "{\n  \"SessionToken\": \"{{randgo_session_token}}\",\n  \"PrimaryKeyName\": \"Cellphone\",\n  \"PrimaryKeyValue\": \"{{test_phone}}\",\n  \"RedemptionType\": \"WebService\",\n  \"IssueExistingBasket\": false,\n  \"Coupons\": [\n    \"{{voucher_guid_1}}\",\n    \"{{voucher_guid_2}}\",\n    \"{{voucher_guid_3}}\",\n    \"{{voucher_guid_4}}\",\n    \"{{voucher_guid_5}}\"\n  ],\n  \"AlternativeCellphone\": \"\",\n  \"AlternativeEmail\": \"\"\n}" }
          },
          "description": "Path: api/Voucher/Coupon/Basket/Checkout\nThis is the PRIMARY call per customer claim.\nIssueExistingBasket=false means we manage our own basket.\nRedemptionType: confirm correct value from request 04."
        },
        {
          "name": "08 CouponBasketHistory (after hours only)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{BASE_URL}}/api/Voucher/Coupon/BasketHistoryGet", "host": ["{{BASE_URL}}"], "path": ["api","Voucher","Coupon","BasketHistoryGet"] },
            "body": { "mode": "raw", "raw": "{\n  \"SessionToken\": \"{{randgo_session_token}}\",\n  \"PrimaryKeyName\": \"Cellphone\",\n  \"PrimaryKeyValue\": \"{{test_phone}}\"\n}" }
          },
          "description": "Path: api/Voucher/Coupon/BasketHistoryGet\nBLOCKING: Only 23:00–05:00."
        },
        {
          "name": "09 Issued Stats (after hours only)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{BASE_URL}}/api/Voucher/Issued", "host": ["{{BASE_URL}}"], "path": ["api","Voucher","Issued"] },
            "body": { "mode": "raw", "raw": "{\n  \"SessionToken\": \"{{randgo_session_token}}\",\n  \"ChannelGuid\": \"\",\n  \"DateFrom\": \"2025-01-01\",\n  \"DateTo\": \"2025-12-31\"\n}" }
          },
          "description": "Path: api/Voucher/Issued\nBLOCKING: Only 23:00–05:00. Calls outside this window = suspension."
        }
      ]
    },

    {
      "name": "👤 04 — Randgo Members",
      "item": [
        {
          "name": "10 PrimaryKeyGet",
          "request": {
            "auth": { "type": "noauth" },
